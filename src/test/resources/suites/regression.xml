<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="API Regression Suite" parallel="false">
    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>
    <test name="Authentication and user profile">
        <groups>
            <run>
                <include name="auth"/>
                <include name="user"/>
            </run>
        </groups>
        <classes>
            <class name="tests.authservice.LoginApiTest"/>
            <class name="tests.authservice.SignUpTest"/>
            <class name="tests.authservice.ForgotPasswordTest"/>
            <class name="tests.usermgmtservice.GetProfileTest"/>
            <class name="tests.usermgmtservice.UpdateProfileTest"/>
        </classes>
    </test>
</suite>
